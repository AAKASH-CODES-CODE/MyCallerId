<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D12"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="bottom">

    <TextView
        android:id="@+id/tvNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textAlignment="center"
        android:layout_marginBottom="40dp"
        android:letterSpacing="0.1"
        android:maxLines="1"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:layout_gravity="center">

        <Button android:id="@+id/btn1" android:text="1" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        <Button android:id="@+id/btn2" android:text="2" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        <Button android:id="@+id/btn3" android:text="3" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        
        <Button android:id="@+id/btn4" android:text="4" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        <Button android:id="@+id/btn5" android:text="5" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        <Button android:id="@+id/btn6" android:text="6" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        
        <Button android:id="@+id/btn7" android:text="7" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        <Button android:id="@+id/btn8" android:text="8" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        <Button android:id="@+id/btn9" android:text="9" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        
        <Button android:id="@+id/btnStar" android:text="*" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        <Button android:id="@+id/btn0" android:text="0" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>
        <Button android:id="@+id/btnHash" android:text="#" android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp" android:textColor="#FFF" android:backgroundTint="#1E1E24"/>

        <Space android:layout_width="80dp" android:layout_height="80dp" android:layout_margin="10dp"/>
        <Button
            android:id="@+id/btnCall"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="📞"
            android:textSize="28sp"
            android:backgroundTint="#00E676"
            android:layout_margin="10dp"/>
        <Button
            android:id="@+id/btnBackspace"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="⌫"
            android:textSize="24sp"
            android:backgroundTint="#2D2D35"
            android:textColor="#BB86FC"
            android:layout_margin="10dp"/>
    </GridLayout>
</LinearLayout>